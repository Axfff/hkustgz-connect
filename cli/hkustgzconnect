#!/usr/bin/env bash
# macOS CLI for the shared HKUST(GZ) Connect engine.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
ROOT="$(cd "$HERE/.." && pwd -P)"
ENGINE_SOURCE_ROOT="$ROOT/engine"
ENGINE_CONFIG="$ROOT/config/hkustgz.json"
PAC_TEMPLATE="$HERE/campus-only.pac.template"
SHADOWROCKET_TEMPLATE="$HERE/shadowrocket-hkustgz.module.template"
SHADOWROCKET_REPAIR_TEMPLATE="$HERE/shadowrocket-hkustgz-repair.module.template"
MIHOMO_TEMPLATE="$HERE/mihomo-hkustgz.yaml.template"
[ -f "$SHADOWROCKET_TEMPLATE" ] \
  || SHADOWROCKET_TEMPLATE="$ROOT/desktop/assets/shadowrocket-hkustgz.module.template"
[ -f "$SHADOWROCKET_REPAIR_TEMPLATE" ] \
  || SHADOWROCKET_REPAIR_TEMPLATE="$ROOT/desktop/assets/shadowrocket-hkustgz-repair.module.template"
[ -f "$MIHOMO_TEMPLATE" ] \
  || MIHOMO_TEMPLATE="$ROOT/desktop/assets/mihomo-hkustgz.yaml.template"

case "$(uname -m)" in
  arm64) ENGINE_ARCH="arm64" ;;
  x86_64) ENGINE_ARCH="amd64" ;;
  *) ENGINE_ARCH="$(uname -m)" ;;
esac
if [ -x "$ENGINE_SOURCE_ROOT/bin/ec-engine-darwin-$ENGINE_ARCH" ]; then
  ENGINE="$ENGINE_SOURCE_ROOT/bin/ec-engine-darwin-$ENGINE_ARCH"
elif [ -x "$ENGINE_SOURCE_ROOT/bin/ec-engine" ]; then
  ENGINE="$ENGINE_SOURCE_ROOT/bin/ec-engine"
else
  ENGINE="$ENGINE_SOURCE_ROOT/target/release/ec-engine"
fi

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/hkustgz-connect"
CONF="${HKUSTGZ_CONFIG:-$CONFIG_HOME/config.toml}"
POLICY="${HKUSTGZ_POLICY:-$CONFIG_HOME/policy.json}"
RUNDIR="$HOME/.hkustgzconnect"
LOG="$RUNDIR/hkustgzconnect.log"
PIDFILE="$RUNDIR/hkustgzconnect.pid"
PAC_FILE="$RUNDIR/campus-only.pac"
SHADOWROCKET_MODULE="$RUNDIR/hkustgz-connect.module"
SHADOWROCKET_REPAIR_MODULE="$RUNDIR/hkustgz-connect-repair.module"
MIHOMO_PROFILE="$RUNDIR/hkustgz-connect-mihomo.yaml"
KEYCHAIN_SERVICE="hkustgzconnect"
SOCKS_HOST="127.0.0.1"
SOCKS_PORT="$(awk -F'[:\"]' '/^socks_bind/{print $(NF-1); exit}' "$CONF" 2>/dev/null)"
SOCKS_PORT="${SOCKS_PORT:-1080}"
LABEL="com.hkustgz.connect"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
FALLBACK_PORT="1081"
FALLBACK_BIN="$ENGINE_SOURCE_ROOT/bin/ec-fallback-darwin-$ENGINE_ARCH"
[ -x "$FALLBACK_BIN" ] || FALLBACK_BIN="$ENGINE_SOURCE_ROOT/target/release/ec-fallback"
[ -z "${HKUSTGZ_FALLBACK_BIN:-}" ] || FALLBACK_BIN="$HKUSTGZ_FALLBACK_BIN"
FALLBACK_INSTALL="$RUNDIR/bin/ec-fallback"
FALLBACK_LABEL="com.hkustgz.connect-fallback"
FALLBACK_PLIST="$HOME/Library/LaunchAgents/$FALLBACK_LABEL.plist"
RELAY_LOCK_FILE="$RUNDIR/compatibility-relay.lock"
DESKTOP_SETTINGS="$HOME/Library/Application Support/hkustgzconnect/settings.json"
CAMPUS_PROBE_URL="https://ssfas.hkust-gz.edu.cn/"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
valid_port() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] && [ "$1" -ge 1025 ] && [ "$1" -le 65535 ]
}
regular_file_or_absent() {
  local file="$1"
  [ ! -L "$file" ] && { [ ! -e "$file" ] || [ -f "$file" ]; }
}
prepare_relay_lock_file() {
  [ ! -L "$RUNDIR" ] && [ -d "$RUNDIR" ] \
    && [ "$(stat -f '%u' "$RUNDIR" 2>/dev/null)" = "$(id -u)" ] \
    || die "compatibility relay state directory is not private and owner-controlled: $RUNDIR"
  if [ -L "$RELAY_LOCK_FILE" ] || { [ -e "$RELAY_LOCK_FILE" ] && [ ! -f "$RELAY_LOCK_FILE" ]; }; then
    die "compatibility relay lock path must be a regular file: $RELAY_LOCK_FILE"
  fi
  if [ ! -e "$RELAY_LOCK_FILE" ]; then
    (set -o noclobber; umask 077; : > "$RELAY_LOCK_FILE") 2>/dev/null || true
  fi
  [ ! -L "$RELAY_LOCK_FILE" ] && [ -f "$RELAY_LOCK_FILE" ] \
    && [ "$(stat -f '%u' "$RELAY_LOCK_FILE" 2>/dev/null)" = "$(id -u)" ] \
    || die "compatibility relay lock file is not owned by this user: $RELAY_LOCK_FILE"
  chmod 600 "$RELAY_LOCK_FILE" || die "could not secure the compatibility relay lock file"
}

run_with_relay_lock() {
  prepare_relay_lock_file
  (
    if /usr/bin/lockf -s -t 0 9; then status=0; else status=$?; fi
    if [ "$status" -eq 75 ]; then
      printf 'error: compatibility relay is busy: another install, update, or remove operation is running\n' >&2
      exit 1
    fi
    if [ "$status" -ne 0 ]; then
      printf 'error: could not acquire the compatibility relay lock (status %s)\n' "$status" >&2
      exit "$status"
    fi
    "$@"
  ) 9<>"$RELAY_LOCK_FILE"
}

plist_argument_value() {
  local file="$1" argument="$2" count index value
  [ ! -L "$file" ] && [ -f "$file" ] || return 1
  count="$(plutil -extract ProgramArguments raw -expect array -o - "$file" 2>/dev/null)" \
    || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  index=0
  while [ "$index" -lt "$count" ]; do
    value="$(plutil -extract "ProgramArguments.$index" raw -expect string -o - "$file" 2>/dev/null)" \
      || return 1
    if [ "$value" = "$argument" ]; then
      index=$((index + 1))
      [ "$index" -lt "$count" ] || return 1
      plutil -extract "ProgramArguments.$index" raw -expect string -o - "$file" 2>/dev/null
      return
    fi
    index=$((index + 1))
  done
  return 1
}
installed_fallback_primary_port() {
  local endpoint port
  endpoint="$(plist_argument_value "$FALLBACK_PLIST" --general-upstream)" || return 1
  case "$endpoint" in
    "$SOCKS_HOST":*) port="${endpoint##*:}" ;;
    *) return 1 ;;
  esac
  valid_port "$port" || return 1
  printf '%s\n' "$port"
}
desktop_primary_proxy_port() {
  local owner permissions permissions_value port
  [ ! -L "$DESKTOP_SETTINGS" ] && [ -f "$DESKTOP_SETTINGS" ] || return 1
  owner="$(stat -f '%u' "$DESKTOP_SETTINGS" 2>/dev/null)" || return 1
  [ "$owner" = "$(id -u)" ] || return 1
  permissions="$(stat -f '%Lp' "$DESKTOP_SETTINGS" 2>/dev/null)" || return 1
  [[ "$permissions" =~ ^[0-7]{3,4}$ ]] || return 1
  permissions_value=$((8#$permissions))
  [ $((permissions_value & 022)) -eq 0 ] || return 1
  port="$(plutil -extract primaryProxyPort raw -expect integer -o - "$DESKTOP_SETTINGS" 2>/dev/null)" \
    || return 1
  valid_port "$port" || return 1
  printf '%s\n' "$port"
}
resolve_primary_proxy_port() {
  local candidate
  if [ -n "${HKUSTGZ_PRIMARY_PROXY_PORT:-}" ]; then
    PRIMARY_PROXY_PORT="$HKUSTGZ_PRIMARY_PROXY_PORT"
    PRIMARY_PROXY_SOURCE="HKUSTGZ_PRIMARY_PROXY_PORT"
  elif [ -n "${HKUSTGZ_SHADOWROCKET_PORT:-}" ]; then
    PRIMARY_PROXY_PORT="$HKUSTGZ_SHADOWROCKET_PORT"
    PRIMARY_PROXY_SOURCE="HKUSTGZ_SHADOWROCKET_PORT"
  elif candidate="$(installed_fallback_primary_port)"; then
    PRIMARY_PROXY_PORT="$candidate"
    PRIMARY_PROXY_SOURCE="installed relay"
  elif candidate="$(desktop_primary_proxy_port)"; then
    PRIMARY_PROXY_PORT="$candidate"
    PRIMARY_PROXY_SOURCE="desktop settings"
  else
    PRIMARY_PROXY_PORT="1082"
    PRIMARY_PROXY_SOURCE="default"
  fi
}
ipv4_number() {
  local address="$1" first second third fourth octet
  [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r first second third fourth <<< "$address"
  for octet in "$first" "$second" "$third" "$fourth"; do
    [[ "$octet" =~ ^(0|[1-9][0-9]{0,2})$ ]] && [ "$octet" -le 255 ] || return 1
  done
  printf '%s\n' "$((first * 16777216 + second * 65536 + third * 256 + fourth))"
}
valid_ipv4_cidr() {
  local cidr="$1" address prefix number host_bits block
  [[ "$cidr" =~ ^[^/]+/([1-9]|[12][0-9]|3[0-2])$ ]] || return 1
  address="${cidr%/*}"
  prefix="${cidr#*/}"
  number="$(ipv4_number "$address")" || return 1
  host_bits=$((32 - prefix))
  block=$((1 << host_bits))
  [ $((number % block)) -eq 0 ]
}
validate_policy_file() {
  local file="$1" version dns_count route_count index address number first cidr keys_file remaining policy_key
  version="$(plutil -extract version raw -expect integer -o - "$file" 2>/dev/null)" \
    || die "network policy must contain integer version 1"
  [ "$version" = "1" ] || die "network policy version must be 1"
  dns_count="$(plutil -extract vpn_dns_servers raw -expect array -o - "$file" 2>/dev/null)" \
    || die "network policy must contain a vpn_dns_servers array"
  route_count="$(plutil -extract route_ipv4_cidrs raw -expect array -o - "$file" 2>/dev/null)" \
    || die "network policy must contain a route_ipv4_cidrs array"
  [[ "$dns_count" =~ ^[0-9]+$ ]] && [ "$dns_count" -le 4 ] \
    || die "network policy VPN DNS servers are limited to 4 entries"
  [[ "$route_count" =~ ^[0-9]+$ ]] && [ "$route_count" -le 128 ] \
    || die "network policy IPv4 routes are limited to 128 entries"
  keys_file="$(mktemp "${TMPDIR:-/tmp}/hkustgz-policy-keys.XXXXXX")" \
    || die "cannot create a temporary policy validator"
  cp "$file" "$keys_file" \
    || { rm -f "$keys_file"; die "cannot inspect network policy keys"; }
  for policy_key in version vpn_dns_servers route_ipv4_cidrs; do
    plutil -remove "$policy_key" "$keys_file" >/dev/null 2>&1 \
      || { rm -f "$keys_file"; die "network policy structure is invalid"; }
  done
  remaining="$(plutil -convert json -o - "$keys_file" 2>/dev/null)" \
    || { rm -f "$keys_file"; die "network policy structure is invalid"; }
  rm -f "$keys_file" || die "cannot remove the temporary policy validator"
  [ "$remaining" = "{}" ] || die "network policy contains unsupported keys"
  index=0
  while [ "$index" -lt "$dns_count" ]; do
    address="$(plutil -extract "vpn_dns_servers.$index" raw -expect string -o - "$file" 2>/dev/null)" \
      || die "network policy VPN DNS[$index] must be a string"
    number="$(ipv4_number "$address")" \
      || die "network policy VPN DNS[$index] is invalid: $address"
    first="${address%%.*}"
    [ "$number" -ne 0 ] && [ "$number" -ne 4294967295 ] \
      && { [ "$first" -lt 224 ] || [ "$first" -gt 239 ]; } \
      || die "network policy VPN DNS[$index] is unusable: $address"
    index=$((index + 1))
  done
  index=0
  while [ "$index" -lt "$route_count" ]; do
    cidr="$(plutil -extract "route_ipv4_cidrs.$index" raw -expect string -o - "$file" 2>/dev/null)" \
      || die "network policy route[$index] must be a string"
    valid_ipv4_cidr "$cidr" \
      || die "network policy route[$index] is invalid or noncanonical: $cidr"
    index=$((index + 1))
  done
}
resolve_primary_proxy_port
valid_port "$SOCKS_PORT" || die "SOCKS port must be within 1025..65535"
valid_port "$PRIMARY_PROXY_PORT" || die "primary proxy SOCKS port must be within 1025..65535"

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
touch "$LOG"
chmod 600 "$LOG"

ACC="$(awk -F'"' '/^username/{print $2; exit}' "$CONF" 2>/dev/null)"
require_account() {
  [ -f "$CONF" ] || die "identity is not configured; run: $(basename "$0") configure"
  [ -n "$ACC" ] || die "username is missing from $CONF"
}

get_pw() { security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$ACC" -w 2>/dev/null; }
socks_listening() { lsof -nP -iTCP@"$SOCKS_HOST":"$SOCKS_PORT" -sTCP:LISTEN >/dev/null 2>&1; }
fallback_port_listening() { lsof -nP -iTCP@"$SOCKS_HOST":"$FALLBACK_PORT" -sTCP:LISTEN >/dev/null 2>&1; }
listener_pids() { lsof -nP -t -iTCP@"$SOCKS_HOST":"$SOCKS_PORT" -sTCP:LISTEN 2>/dev/null; }
fallback_listener_pids() { lsof -nP -t -iTCP@"$SOCKS_HOST":"$FALLBACK_PORT" -sTCP:LISTEN 2>/dev/null; }
listener_executable() {
  local pid="$1"
  lsof -a -p "$pid" -d txt -Fn 2>/dev/null | awk '/^n/{print substr($0,2); exit}'
}
shared_engine_listening() {
  local pid executable name listeners=0 engines=0
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    listeners=$((listeners + 1))
    executable="$(listener_executable "$pid")"
    name="${executable##*/}"
    case "$name" in ec-engine|ec-engine-*) engines=$((engines + 1)) ;; esac
  done < <(listener_pids)
  [ "$listeners" -eq 1 ] && [ "$engines" -eq 1 ]
}
fallback_listener_pid() {
  local pid executable listeners=0 relay_pid=''
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    listeners=$((listeners + 1))
    executable="$(listener_executable "$pid")"
    [ "$executable" = "$FALLBACK_INSTALL" ] && relay_pid="$pid"
  done < <(fallback_listener_pids)
  [ "$listeners" -eq 1 ] && [ -n "$relay_pid" ] || return 1
  printf '%s\n' "$relay_pid"
}
fallback_launchd_pid() {
  launchctl print "gui/$(id -u)/$FALLBACK_LABEL" 2>/dev/null \
    | awk '$1 == "pid" && $2 == "=" && $3 ~ /^[0-9]+$/ {print $3; exit}'
}
fallback_service_loaded() {
  launchctl print "gui/$(id -u)/$FALLBACK_LABEL" >/dev/null 2>&1
}
fallback_relay_listening() {
  local listener_pid launchd_pid
  listener_pid="$(fallback_listener_pid)" || return 1
  launchd_pid="$(fallback_launchd_pid)" || return 1
  [ -n "$launchd_pid" ] && [ "$listener_pid" = "$launchd_pid" ]
}
installed_fallback_interface() {
  local network_interface
  network_interface="$(plist_argument_value "$FALLBACK_PLIST" --direct-interface)" || return 1
  [[ "$network_interface" =~ ^en[0-9]+$ ]] || return 1
  printf '%s\n' "$network_interface"
}
fallback_config_current() {
  local upstream primary
  upstream="$(plist_argument_value "$FALLBACK_PLIST" --upstream)" || return 1
  primary="$(plist_argument_value "$FALLBACK_PLIST" --general-upstream)" || return 1
  [ "$upstream" = "$SOCKS_HOST:$SOCKS_PORT" ] \
    && [ "$primary" = "$SOCKS_HOST:$PRIMARY_PROXY_PORT" ]
}
owned_engine_pid() {
  local pid executable
  [ -f "$PIDFILE" ] || return 1
  pid="$(awk 'NR==1 && /^[0-9]+$/{print; exit}' "$PIDFILE" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  executable="$(listener_executable "$pid")"
  [ "$executable" = "$ENGINE" ] || return 1
  printf '%s\n' "$pid"
}
engine_process_running() { owned_engine_pid >/dev/null 2>&1; }
svc_loaded() { launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }

probe_campus_http_code() {
  curl -sS --noproxy '' --proxy "socks5h://$SOCKS_HOST:$SOCKS_PORT" \
    --connect-timeout 3 --max-time 6 -o /dev/null -w '%{http_code}' \
    "$CAMPUS_PROBE_URL" 2>/dev/null
}
probe_data_plane() {
  local http_code
  http_code="$(probe_campus_http_code)"
  if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
    PROBE_SUMMARY="campus HTTPS $http_code"
    return 0
  fi
  PROBE_SUMMARY=""
  return 1
}

ensure_engine() {
  [ -x "$ENGINE" ] && return 0
  [ -f "$ENGINE_SOURCE_ROOT/Cargo.toml" ] || die "packaged engine is missing: $ENGINE"
  if command -v cargo >/dev/null 2>&1; then
    cargo_runner=(cargo)
  elif command -v rustup >/dev/null 2>&1; then
    toolchain_bin="$(dirname "$(rustup which rustc --toolchain 1.97.1)")"
    cargo_runner=(env "PATH=$toolchain_bin:$PATH" rustup run 1.97.1 cargo)
  else
    die "engine is missing and cargo/rustup is unavailable"
  fi
  (cd "$ENGINE_SOURCE_ROOT" && LZMA_API_STATIC=1 "${cargo_runner[@]}" build --locked --release --bin ec-engine) \
    || die "engine build failed"
}
ensure_fallback() {
  [ -x "$FALLBACK_BIN" ] && return 0
  [ -f "$ENGINE_SOURCE_ROOT/Cargo.toml" ] || die "packaged fallback relay is missing: $FALLBACK_BIN"
  if command -v cargo >/dev/null 2>&1; then
    cargo_runner=(cargo)
  elif command -v rustup >/dev/null 2>&1; then
    toolchain_bin="$(dirname "$(rustup which rustc --toolchain 1.97.1)")"
    cargo_runner=(env "PATH=$toolchain_bin:$PATH" rustup run 1.97.1 cargo)
  else
    die "fallback relay is missing and cargo/rustup is unavailable"
  fi
  (cd "$ENGINE_SOURCE_ROOT" && LZMA_API_STATIC=1 "${cargo_runner[@]}" build --locked --release --bin ec-fallback) \
    || die "fallback relay build failed"
}
write_pac() {
  [ -f "$PAC_TEMPLATE" ] || die "PAC template is missing: $PAC_TEMPLATE"
  local temporary="$PAC_FILE.$$.tmp" route_cidrs='[]'
  if [ -f "$POLICY" ]; then
    route_cidrs="$(plutil -extract route_ipv4_cidrs json -expect array -o - "$POLICY" 2>/dev/null)" \
      || die "local network policy is invalid: $POLICY"
  fi
  sed -e "s/__SOCKS_PORT__/$SOCKS_PORT/g" -e "s|__ROUTE_IPV4_CIDRS__|$route_cidrs|g" "$PAC_TEMPLATE" > "$temporary" \
    || { [ -f "$temporary" ] && mv "$temporary" "$temporary.failed"; die "cannot generate PAC"; }
  chmod 600 "$temporary"
  mv "$temporary" "$PAC_FILE"
}
write_shadowrocket_module() {
  local template="${1:-$SHADOWROCKET_TEMPLATE}" output="${2:-$SHADOWROCKET_MODULE}"
  [ -f "$template" ] || die "Shadowrocket module template is missing"
  local temporary="$output.$$.tmp"
  local route_marker='__ROUTE_IPV4_RULES__' tun_marker='__TUN_INCLUDED_ROUTES__'
  local udp_marker='__UDP_REJECT_RULES__'
  local policy_route_count=0 route_index=0 route_count=0 tun_count=0 udp_count=0 route_csv='' cidr line
  local -a routes=()
  if [ -f "$POLICY" ]; then
    policy_route_count="$(plutil -extract route_ipv4_cidrs raw -expect array -o - "$POLICY" 2>/dev/null)" \
      || die "local network policy is invalid: $POLICY"
    [[ "$policy_route_count" =~ ^[0-9]+$ ]] \
      || die "local network policy has an invalid route array: $POLICY"
  fi
  while [ "$route_index" -lt "$policy_route_count" ]; do
    cidr="$(plutil -extract "route_ipv4_cidrs.$route_index" raw -expect string -o - "$POLICY" 2>/dev/null)" \
      || die "local network policy route[$route_index] must be a string"
    valid_ipv4_cidr "$cidr" \
      || die "local network policy route[$route_index] is invalid: $cidr"
    routes+=("$cidr")
    [ -z "$route_csv" ] && route_csv="$cidr" || route_csv="$route_csv, $cidr"
    route_index=$((route_index + 1))
  done
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$tun_marker")
        tun_count=$((tun_count + 1))
        [ -z "$route_csv" ] || printf 'tun-included-routes = %s\n' "$route_csv" >> "$temporary"
        ;;
      "$route_marker")
        route_count=$((route_count + 1))
        for cidr in "${routes[@]-}"; do
          [ -n "$cidr" ] || continue
          printf 'IP-CIDR,%s,HKUSTGZ,no-resolve\n' "$cidr" >> "$temporary"
        done
        ;;
      "$udp_marker")
        udp_count=$((udp_count + 1))
        for cidr in "${routes[@]-}"; do
          [ -n "$cidr" ] || continue
          printf 'AND,((PROTOCOL,UDP),(IP-CIDR,%s,no-resolve)),REJECT-NO-DROP\n' "$cidr" >> "$temporary"
        done
        ;;
      *) printf '%s\n' "$line" >> "$temporary" ;;
    esac
  done < "$template"
  [ "$route_count" -eq 1 ] && [ "$tun_count" -eq 1 ] && [ "$udp_count" -eq 1 ] \
    || { [ -f "$temporary" ] && mv "$temporary" "$temporary.failed"; die "Shadowrocket module template is invalid"; }
  chmod 600 "$temporary"
  mv "$temporary" "$output"
}

write_mihomo_profile() {
  [ -f "$MIHOMO_TEMPLATE" ] || die "Mihomo profile template is missing"
  local temporary="$MIHOMO_PROFILE.$$.tmp"
  local port_marker='__SOCKS_PORT__' domain_marker='__ROUTE_DOMAIN_RULES__'
  local udp_marker='__UDP_REJECT_RULES__' ipv4_marker='__ROUTE_IPV4_RULES__'
  local route_count=0 domain_count=0 udp_count=0 port_count=0
  local policy_route_count=0 route_index=0 domain_total=0 domain_index=0 cidr domain line
  local -a routes=() domains=()
  if [ -f "$POLICY" ]; then
    policy_route_count="$(plutil -extract route_ipv4_cidrs raw -expect array -o - "$POLICY" 2>/dev/null)" \
      || die "local network policy is invalid: $POLICY"
  fi
  while [ "$route_index" -lt "$policy_route_count" ]; do
    cidr="$(plutil -extract "route_ipv4_cidrs.$route_index" raw -expect string -o - "$POLICY" 2>/dev/null)" \
      || die "local network policy route[$route_index] must be a string"
    valid_ipv4_cidr "$cidr" \
      || die "local network policy route[$route_index] is invalid: $cidr"
    routes+=("$cidr")
    route_index=$((route_index + 1))
  done
  domain_total="$(plutil -extract proxy.route_domains raw -expect array -o - "$ENGINE_CONFIG" 2>/dev/null)" \
    || die "engine route-domain configuration is invalid"
  while [ "$domain_index" -lt "$domain_total" ]; do
    domain="$(plutil -extract "proxy.route_domains.$domain_index" raw -expect string -o - "$ENGINE_CONFIG" 2>/dev/null)" \
      || die "engine route domain[$domain_index] must be a string"
    [[ "$domain" =~ ^([A-Za-z0-9-]+\.)+[A-Za-z]{2,}$ ]] \
      || die "engine route domain[$domain_index] is invalid"
    domains+=("$domain")
    domain_index=$((domain_index + 1))
  done
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *"$port_marker"*)
        port_count=$((port_count + 1))
        printf '%s\n' "${line//$port_marker/$SOCKS_PORT}" >> "$temporary"
        ;;
      "$udp_marker")
        udp_count=$((udp_count + 1))
        for domain in "${domains[@]-}"; do
          [ -n "$domain" ] || continue
          printf '  - AND,((DOMAIN-SUFFIX,%s),(NETWORK,udp)),REJECT\n' "$domain" >> "$temporary"
        done
        for cidr in "${routes[@]-}"; do
          [ -n "$cidr" ] || continue
          printf '  - AND,((IP-CIDR,%s,no-resolve),(NETWORK,udp)),REJECT\n' "$cidr" >> "$temporary"
        done
        ;;
      "$domain_marker")
        domain_count=$((domain_count + 1))
        for domain in "${domains[@]-}"; do
          [ -n "$domain" ] || continue
          printf '  - DOMAIN-SUFFIX,%s,HKUSTGZ\n' "$domain" >> "$temporary"
        done
        ;;
      "$ipv4_marker")
        route_count=$((route_count + 1))
        for cidr in "${routes[@]-}"; do
          [ -n "$cidr" ] || continue
          printf '  - IP-CIDR,%s,HKUSTGZ,no-resolve\n' "$cidr" >> "$temporary"
        done
        ;;
      *) printf '%s\n' "$line" >> "$temporary" ;;
    esac
  done < "$MIHOMO_TEMPLATE"
  [ "$port_count" -eq 1 ] && [ "$udp_count" -eq 1 ] \
    && [ "$domain_count" -eq 1 ] && [ "$route_count" -eq 1 ] \
    || { [ -f "$temporary" ] && mv "$temporary" "$temporary.failed"; die "Mihomo template is invalid"; }
  chmod 600 "$temporary"
  mv "$temporary" "$MIHOMO_PROFILE"
}

interface_active() {
  local network_interface="$1"
  [[ "$network_interface" =~ ^en[0-9]+$ ]] || return 1
  /sbin/ifconfig "$network_interface" 2>/dev/null \
    | grep -Eq '^[[:space:]]*status:[[:space:]]*active[[:space:]]*$'
}
select_physical_interface() {
  local current_interface="$1" saved_interface="$2"
  local current_active="$3" saved_active="$4"
  if [[ "$current_interface" =~ ^en[0-9]+$ ]] && [ "$current_active" -eq 1 ]; then
    printf '%s\n' "$current_interface"
    return
  fi
  if [[ "$current_interface" =~ ^utun[0-9]+$ ]] \
    && [[ "$saved_interface" =~ ^en[0-9]+$ ]] && [ "$saved_active" -eq 1 ]; then
    printf '%s\n' "$saved_interface"
    return
  fi
  return 1
}
preferred_physical_interface() {
  local saved_interface="$1" current_interface current_active=0 saved_active=0
  current_interface="$(/sbin/route -n get default 2>/dev/null \
    | awk '/^[[:space:]]*interface:/{print $2; exit}')"
  interface_active "$current_interface" && current_active=1
  interface_active "$saved_interface" && saved_active=1
  select_physical_interface \
    "$current_interface" "$saved_interface" "$current_active" "$saved_active"
}
xml_escape() {
  local value="$1"
  if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then return 1; fi
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  printf '%s' "$value"
}
render_fallback_plist() {
  local output="$1" direct_interface="$2"
  local executable_xml label_xml upstream_xml primary_xml interface_xml stdout_xml stderr_xml
  [[ "$direct_interface" =~ ^en[0-9]+$ ]] || return 1
  executable_xml="$(xml_escape "$FALLBACK_INSTALL")" || return 1
  label_xml="$(xml_escape "$FALLBACK_LABEL")" || return 1
  upstream_xml="$(xml_escape "$SOCKS_HOST:$SOCKS_PORT")" || return 1
  primary_xml="$(xml_escape "$SOCKS_HOST:$PRIMARY_PROXY_PORT")" || return 1
  interface_xml="$(xml_escape "$direct_interface")" || return 1
  stdout_xml="$(xml_escape "$RUNDIR/fallback.out.log")" || return 1
  stderr_xml="$(xml_escape "$RUNDIR/fallback.err.log")" || return 1
  printf '%s\n' \
    '<?xml version="1.0" encoding="UTF-8"?>' \
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
    '<plist version="1.0"><dict>' \
    "<key>Label</key><string>$label_xml</string>" \
    '<key>ProgramArguments</key><array>' \
    "<string>$executable_xml</string>" \
    '<string>--listen</string><string>127.0.0.1:1081</string>' \
    "<string>--upstream</string><string>$upstream_xml</string>" \
    "<string>--general-upstream</string><string>$primary_xml</string>" \
    "<string>--direct-interface</string><string>$interface_xml</string>" \
    '</array>' \
    '<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>' \
    '<key>ThrottleInterval</key><integer>10</integer>' \
    "<key>StandardOutPath</key><string>$stdout_xml</string>" \
    "<key>StandardErrorPath</key><string>$stderr_xml</string>" \
    '</dict></plist>' > "$output" || return 1
  chmod 600 "$output" || return 1
  plutil -lint "$output" >/dev/null 2>&1
}
replace_file_atomic() {
  local source="$1" target="$2" mode="$3" directory temporary
  directory="$(dirname "$target")"
  temporary="$(mktemp "$directory/.${target##*/}.replace.XXXXXX")" || return 1
  if ! install -m "$mode" "$source" "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  if ! mv "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}
restore_file_atomic() {
  local source="$1" target="$2" directory temporary
  directory="$(dirname "$target")"
  temporary="$(mktemp "$directory/.${target##*/}.restore.XXXXXX")" || return 1
  if ! cp -p "$source" "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  if ! mv "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}
bootout_fallback_service() {
  launchctl bootout "gui/$(id -u)/$FALLBACK_LABEL" 2>/dev/null \
    || ! fallback_service_loaded
}

FALLBACK_TX_ACTIVE=0
FALLBACK_TX_DIR=''
FALLBACK_TX_NEW_PLIST=''
FALLBACK_TX_HAD_BIN=0
FALLBACK_TX_HAD_PLIST=0
FALLBACK_TX_WAS_LOADED=0
FALLBACK_TX_SERVICE_STOPPED=0
FALLBACK_TX_FILES_MUTATED=0

fallback_transaction_begin() {
  local new_plist="$1" rollback_dir
  rollback_dir="$(mktemp -d "$RUNDIR/fallback-rollback.XXXXXX")" || return 1
  chmod 700 "$rollback_dir" || { rm -rf "$rollback_dir"; return 1; }
  FALLBACK_TX_DIR="$rollback_dir"
  FALLBACK_TX_NEW_PLIST="$new_plist"
  FALLBACK_TX_HAD_BIN=0
  FALLBACK_TX_HAD_PLIST=0
  FALLBACK_TX_WAS_LOADED=0
  FALLBACK_TX_SERVICE_STOPPED=0
  FALLBACK_TX_FILES_MUTATED=0
  if [ -f "$FALLBACK_INSTALL" ]; then
    cp -p "$FALLBACK_INSTALL" "$rollback_dir/ec-fallback" \
      || { rm -rf "$rollback_dir"; return 1; }
    FALLBACK_TX_HAD_BIN=1
  fi
  if [ -f "$FALLBACK_PLIST" ]; then
    cp -p "$FALLBACK_PLIST" "$rollback_dir/$FALLBACK_LABEL.plist" \
      || { rm -rf "$rollback_dir"; return 1; }
    FALLBACK_TX_HAD_PLIST=1
  fi
  fallback_service_loaded && FALLBACK_TX_WAS_LOADED=1
  FALLBACK_TX_ACTIVE=1
  trap 'fallback_transaction_on_exit $?' EXIT
  trap 'exit 130' HUP INT TERM
}
fallback_transaction_restore() {
  local restore_failed=0
  trap - EXIT
  trap '' HUP INT TERM
  FALLBACK_TX_ACTIVE=0
  if [ "$FALLBACK_TX_SERVICE_STOPPED" -eq 1 ] && fallback_service_loaded; then
    bootout_fallback_service || restore_failed=1
  fi
  if [ "$restore_failed" -eq 0 ] && [ "$FALLBACK_TX_FILES_MUTATED" -eq 1 ]; then
    if [ "$FALLBACK_TX_HAD_BIN" -eq 1 ]; then
      restore_file_atomic "$FALLBACK_TX_DIR/ec-fallback" "$FALLBACK_INSTALL" \
        || restore_failed=1
    else
      [ ! -e "$FALLBACK_INSTALL" ] || rm -f "$FALLBACK_INSTALL" || restore_failed=1
    fi
    if [ "$FALLBACK_TX_HAD_PLIST" -eq 1 ]; then
      restore_file_atomic "$FALLBACK_TX_DIR/$FALLBACK_LABEL.plist" "$FALLBACK_PLIST" \
        || restore_failed=1
    else
      [ ! -e "$FALLBACK_PLIST" ] || rm -f "$FALLBACK_PLIST" || restore_failed=1
    fi
  fi
  if [ "$restore_failed" -eq 0 ] && [ "$FALLBACK_TX_WAS_LOADED" -eq 1 ] \
    && [ "$FALLBACK_TX_SERVICE_STOPPED" -eq 1 ]; then
    launchctl bootstrap "gui/$(id -u)" "$FALLBACK_PLIST" >/dev/null 2>&1 \
      && fallback_service_loaded \
      || restore_failed=1
  fi
  rm -f "$FALLBACK_TX_NEW_PLIST" 2>/dev/null || true
  if [ "$restore_failed" -ne 0 ]; then
    printf 'error: previous relay restore failed; backup retained at %s\n' "$FALLBACK_TX_DIR" >&2
    trap - HUP INT TERM
    return 1
  fi
  rm -rf "$FALLBACK_TX_DIR" \
    || printf 'warning: restored relay but could not remove backup %s\n' "$FALLBACK_TX_DIR" >&2
  trap - HUP INT TERM
  return 0
}
fallback_transaction_on_exit() {
  local status="$1"
  [ "$FALLBACK_TX_ACTIVE" -eq 1 ] || return
  printf 'error: relay installation was interrupted; restoring previous state\n' >&2
  fallback_transaction_restore || status=1
  exit "$status"
}
fallback_transaction_abort() {
  local message="$1" backup="$FALLBACK_TX_DIR"
  if fallback_transaction_restore; then
    die "$message; previous state restored"
  fi
  die "$message; previous state restore failed; backup retained at $backup"
}
fallback_transaction_commit() {
  trap - EXIT HUP INT TERM
  FALLBACK_TX_ACTIVE=0
  rm -f "$FALLBACK_TX_NEW_PLIST" \
    || printf 'warning: could not remove temporary relay plist %s\n' "$FALLBACK_TX_NEW_PLIST" >&2
  rm -rf "$FALLBACK_TX_DIR" \
    || printf 'warning: could not remove relay backup %s\n' "$FALLBACK_TX_DIR" >&2
}

probe_upgrade_shaped_https_path() {
  local host="$1" proxy="${2:-}" http_code
  local -a args=(--http1.1 --connect-timeout 4 --max-time 8 -sS -o /dev/null -w '%{http_code}'
    -H 'Connection: Upgrade' -H 'Upgrade: websocket' -H 'Sec-WebSocket-Version: 13'
    -H 'Sec-WebSocket-Key: aGt1c3Rnei1jb25uZWN0IQ==')
  if [ -z "$proxy" ]; then
    args+=(--noproxy '*')
  else
    args+=(--noproxy '' --proxy "$proxy")
  fi
  http_code="$(curl "${args[@]}" "https://$host/" 2>/dev/null)" || true
  [ -n "$http_code" ] && [ "$http_code" != "000" ]
}

doctor_public_network() {
  local failed=0 differential=0 explicit_proxy="socks5h://$SOCKS_HOST:$PRIMARY_PROXY_PORT" host system_ok proxy_ok
  printf 'primary proxy test endpoint: %s (%s)\n' "$explicit_proxy" "$PRIMARY_PROXY_SOURCE"
  for host in chatgpt.com ws.chatgpt.com; do
    system_ok=0
    proxy_ok=0
    probe_upgrade_shaped_https_path "$host" && system_ok=1
    probe_upgrade_shaped_https_path "$host" "$explicit_proxy" && proxy_ok=1
    if [ "$system_ok" -eq 1 ]; then
      printf 'pass: %s system/TUN returned an HTTP response to an Upgrade-shaped HTTPS request; persistent realtime was not verified\n' "$host"
    else
      printf 'fail: %s returned no HTTP response through the system/TUN path\n' "$host" >&2
      failed=1
    fi
    if [ "$proxy_ok" -eq 1 ]; then
      printf 'pass: %s returned an HTTP response through %s; persistent realtime was not verified\n' "$host" "$explicit_proxy"
    else
      printf 'fail: %s returned no HTTP response through %s\n' "$host" "$explicit_proxy" >&2
      failed=1
    fi
    [ "$system_ok" -eq 1 ] || [ "$proxy_ok" -ne 1 ] || differential=1
  done
  if [ "$differential" -eq 1 ]; then
    printf 'review: the explicit primary SOCKS path responds while the system/TUN path does not\n' >&2
    printf 'review: if Shadowrocket owns that endpoint, replace the campus-only module with %s and keep exactly one enabled\n' "$SHADOWROCKET_MODULE" >&2
    printf 'verify: retest persistent streaming in the affected app; these probes verify HTTPS reachability only\n' >&2
  elif [ "$failed" -ne 0 ]; then
    printf 'review: no repair-preset differential was established; verify the printed SOCKS endpoint, DNS, and upstream before changing global policy\n' >&2
  fi
  return "$failed"
}
rotate_log() {
  [ -s "$LOG" ] && cp -p "$LOG" "$LOG.previous"
  : > "$LOG"
  chmod 600 "$LOG"
}
wait_socks() {
  for _ in $(seq 1 20); do
    shared_engine_listening && return 0
    grep -qiE "authentication failed|unsupported|ec-engine:" "$LOG" 2>/dev/null && return 1
    sleep 1
  done
  shared_engine_listening
}
report_up() {
  if ! shared_engine_listening; then
    printf 'failed to start; last log lines:\n' >&2
    tail -8 "$LOG" 2>/dev/null | sed 's/^/  /' >&2
    return 1
  fi
  if probe_data_plane; then
    printf 'running: SOCKS5 %s:%s (campus data path healthy)\n' "$SOCKS_HOST" "$SOCKS_PORT"
    printf 'probe: %s\n' "$PROBE_SUMMARY"
  else
    printf 'starting: SOCKS5 %s:%s (campus probe pending)\n' "$SOCKS_HOST" "$SOCKS_PORT"
  fi
  printf 'PAC: file://%s\n' "$PAC_FILE"
}
run_engine() {
  local pw engine_pid
  local -a engine_args
  pw="$(get_pw)" || true
  [ -n "${pw:-}" ] || die "no password in Keychain; run: $(basename "$0") set-password"
  engine_args=(--config "$ENGINE_CONFIG" --credentials-stdin --socks-bind "$SOCKS_HOST:$SOCKS_PORT")
  [ -f "$POLICY" ] && engine_args+=(--local-policy "$POLICY")
  {
    printf '%s\n' "$ACC"
    printf '%s\n' "$pw"
  } | "$ENGINE" "${engine_args[@]}" &
  engine_pid=$!
  printf '%s\n' "$engine_pid" > "$PIDFILE"
  chmod 600 "$PIDFILE"
  wait "$engine_pid"
}

install_fallback_relay() {
  local direct_interface new_plist relay_ready=0
  [ "$SOCKS_PORT" != "$FALLBACK_PORT" ] && [ "$SOCKS_PORT" != "$PRIMARY_PROXY_PORT" ] \
    && [ "$FALLBACK_PORT" != "$PRIMARY_PROXY_PORT" ] \
    || die "campus, relay, and primary proxy ports must be different"
  write_shadowrocket_module
  ensure_fallback
  if fallback_port_listening && ! fallback_relay_listening; then
    die "relay port $FALLBACK_PORT is owned by another process or unmanaged relay"
  fi
  direct_interface="$(preferred_physical_interface \
    "$(installed_fallback_interface 2>/dev/null)")" \
    || die "cannot identify a physical default interface; disable the primary TUN briefly and retry"
  mkdir -p "$RUNDIR/bin" "$(dirname "$FALLBACK_PLIST")" \
    || die "could not create relay directories"
  chmod 700 "$RUNDIR/bin" || die "could not secure the relay binary directory"
  for relay_target in "$FALLBACK_INSTALL" "$FALLBACK_PLIST"; do
    regular_file_or_absent "$relay_target" \
      || die "relay state must use regular files: $relay_target"
  done
  new_plist="$(mktemp "$RUNDIR/$FALLBACK_LABEL.plist.new.XXXXXX")" \
    || die "could not create a temporary relay LaunchAgent"
  render_fallback_plist "$new_plist" "$direct_interface" \
    || { rm -f "$new_plist"; die "could not render a valid relay LaunchAgent"; }
  fallback_transaction_begin "$new_plist" \
    || { rm -f "$new_plist"; die "could not preserve the current relay state"; }
  if fallback_service_loaded; then
    if ! bootout_fallback_service; then
      fallback_service_loaded || FALLBACK_TX_SERVICE_STOPPED=1
      fallback_transaction_abort "could not stop the previous compatibility relay"
    fi
    FALLBACK_TX_SERVICE_STOPPED=1
  fi
  replace_file_atomic "$FALLBACK_BIN" "$FALLBACK_INSTALL" 755 \
    || fallback_transaction_abort "could not install the compatibility relay executable"
  FALLBACK_TX_FILES_MUTATED=1
  replace_file_atomic "$new_plist" "$FALLBACK_PLIST" 600 \
    || fallback_transaction_abort "could not install the compatibility relay LaunchAgent"
  FALLBACK_TX_SERVICE_STOPPED=1
  launchctl bootstrap "gui/$(id -u)" "$FALLBACK_PLIST" >/dev/null 2>&1 \
    || fallback_transaction_abort "could not load the compatibility relay LaunchAgent"
  for _ in $(seq 1 20); do
    if fallback_relay_listening; then relay_ready=1; break; fi
    sleep 0.1
  done
  [ "$relay_ready" -eq 1 ] \
    || fallback_transaction_abort "compatibility relay did not claim $SOCKS_HOST:$FALLBACK_PORT as the LaunchAgent PID"
  fallback_transaction_commit
  printf 'compatibility relay installed on %s:%s; module: %s\n' \
    "$SOCKS_HOST" "$FALLBACK_PORT" "$SHADOWROCKET_MODULE"
  printf 'primary proxy endpoint: socks5h://%s:%s (%s)\n' \
    "$SOCKS_HOST" "$PRIMARY_PROXY_PORT" "$PRIMARY_PROXY_SOURCE"
}

uninstall_fallback_relay() {
  local relay_target remove_failed=0
  for relay_target in "$FALLBACK_INSTALL" "$FALLBACK_PLIST"; do
    regular_file_or_absent "$relay_target" \
      || die "relay state must use regular files: $relay_target"
  done
  bootout_fallback_service || die "could not stop the compatibility relay"
  for relay_target in "$FALLBACK_PLIST" "$FALLBACK_INSTALL"; do
    if [ -f "$relay_target" ] && ! rm -f "$relay_target"; then
      printf 'error: could not remove %s\n' "$relay_target" >&2
      remove_failed=1
    fi
  done
  [ "$remove_failed" -eq 0 ] || die "compatibility relay removal was incomplete"
  printf 'compatibility relay removed\n'
}

case "${1:-}" in
  configure)
    username="${2:-}"
    port="${3:-1080}"
    if [ -z "$username" ]; then read -r -p "Campus username: " username; fi
    [[ "$username" =~ ^[A-Za-z0-9._@-]+$ ]] || die "username contains unsupported characters"
    valid_port "$port" || die "SOCKS port must be within 1025..65535"
    mkdir -p "$(dirname "$CONF")"
    chmod 700 "$(dirname "$CONF")"
    printf 'username = "%s"\nsocks_bind = "127.0.0.1:%s"\n' "$username" "$port" > "$CONF"
    chmod 600 "$CONF"
    printf 'configuration saved to %s\n' "$CONF"
    ;;

  set-password)
    require_account
    printf 'Password for %s at the HKUST(GZ) gateway (macOS will prompt twice):\n' "$ACC" >&2
    security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$ACC" -w \
      && printf 'password stored in macOS Keychain\n' \
      || die "password was not stored"
    ;;

  set-policy)
    source_policy="${2:-}"
    [ -n "$source_policy" ] || die "usage: $(basename "$0") set-policy FILE"
    [ -f "$source_policy" ] || die "network policy file does not exist: $source_policy"
    validate_policy_file "$source_policy"
    mkdir -p "$CONFIG_HOME"
    chmod 700 "$CONFIG_HOME"
    temporary="$POLICY.$$.tmp"
    cp "$source_policy" "$temporary" || die "cannot copy network policy"
    chmod 600 "$temporary"
    mv "$temporary" "$POLICY"
    printf 'local network policy installed at %s\n' "$POLICY"
    printf 'restart the owning interface to apply it\n'
    ;;

  run)
    if shared_engine_listening && probe_data_plane; then exit 0; fi
    socks_listening && die "SOCKS5 $SOCKS_HOST:$SOCKS_PORT is occupied by another process"
    require_account
    ensure_engine
    run_engine
    ;;

  up)
    if socks_listening; then
      shared_engine_listening || die "SOCKS5 $SOCKS_HOST:$SOCKS_PORT is occupied by another process"
      if probe_data_plane; then
        printf 'attached: shared campus engine is healthy on %s:%s\n' "$SOCKS_HOST" "$SOCKS_PORT"
        printf 'probe: %s\n' "$PROBE_SUMMARY"
        exit 0
      fi
      if engine_process_running; then
        printf 'owned engine is unhealthy; restarting it\n' >&2
        "$0" down >/dev/null 2>&1
        sleep 1
      else
        die "a shared engine owns port $SOCKS_PORT but its campus data path is unhealthy; stop it from its owning interface"
      fi
    fi
    require_account
    ensure_engine
    [ -f "$ENGINE_CONFIG" ] || die "engine profile is missing: $ENGINE_CONFIG"
    write_pac
    get_pw >/dev/null 2>&1 || die "no password in Keychain; run set-password"
    rotate_log
    if [ -f "$PLIST" ]; then
      launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl kickstart "gui/$(id -u)/$LABEL" 2>/dev/null
    else
      nohup "$0" run >>"$LOG" 2>&1 &
      disown 2>/dev/null || true
    fi
    wait_socks
    report_up || { "$0" down >/dev/null 2>&1; exit 1; }
    ;;

  down)
    svc_loaded && launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    pid="$(owned_engine_pid 2>/dev/null)" || true
    if [ -n "${pid:-}" ]; then kill "$pid" 2>/dev/null || true; fi
    [ -f "$PIDFILE" ] && mv "$PIDFILE" "$RUNDIR/hkustgzconnect.pid.stopped"
    sleep 1
    if shared_engine_listening; then
      printf 'detached: a shared engine owned by another interface remains running\n'
    else
      printf 'stopped: no CLI-owned engine is running\n'
    fi
    ;;

  restart)
    "$0" down >/dev/null 2>&1
    sleep 1
    exec "$0" up
    ;;

  status)
    if shared_engine_listening; then
      if probe_data_plane; then
        printf 'running (campus data path healthy)\n'
      else
        printf 'degraded (listener present; campus probe failed or engine is reconnecting)\n'
      fi
      printf 'SOCKS5 %s:%s: shared engine\n' "$SOCKS_HOST" "$SOCKS_PORT"
      owned_engine_pid >/dev/null 2>&1 && printf 'ownership: this CLI\n' || printf 'ownership: another interface\n'
      [ -n "$PROBE_SUMMARY" ] && printf 'probe: %s\n' "$PROBE_SUMMARY"
    elif socks_listening; then
      printf 'blocked: SOCKS5 %s:%s is occupied by another process\n' "$SOCKS_HOST" "$SOCKS_PORT"
    elif engine_process_running; then
      printf 'reconnecting: CLI-owned engine process is running without a listener\n'
    else
      printf 'stopped: no shared engine is listening\n'
    fi
    [ -n "$ACC" ] && printf 'identity: configured\n' || printf 'identity: not configured\n'
    if [ -n "$ACC" ] && get_pw >/dev/null 2>&1; then printf 'Keychain password: present\n'; else printf 'Keychain password: missing\n'; fi
    [ -x "$ENGINE" ] && printf 'engine: available\n' || printf 'engine: not built\n'
    [ -f "$POLICY" ] && printf 'local network policy: present\n' || printf 'local network policy: not installed (public domains only)\n'
    printf 'primary proxy endpoint: SOCKS5 %s:%s (%s)\n' \
      "$SOCKS_HOST" "$PRIMARY_PROXY_PORT" "$PRIMARY_PROXY_SOURCE"
    if fallback_relay_listening; then
      if fallback_config_current; then
        printf 'compatibility relay: %s:%s (owned by ec-fallback)\n' "$SOCKS_HOST" "$FALLBACK_PORT"
      else
        printf 'compatibility relay: running with previous ports; install-fallback required\n'
      fi
    elif fallback_port_listening; then
      printf 'compatibility relay: blocked; port %s is owned by another process\n' "$FALLBACK_PORT"
    elif [ -f "$FALLBACK_PLIST" ]; then
      printf 'compatibility relay: installed but not running\n'
    else
      printf 'compatibility relay: not installed\n'
    fi
    ;;

  test)
    shared_engine_listening || die "shared campus engine is not listening on $SOCKS_HOST:$SOCKS_PORT"
    probe_data_plane || die "campus data path probe failed"
    printf '%s\n' "$PROBE_SUMMARY"
    ;;

  pac)
    write_pac
    printf 'file://%s\n' "$PAC_FILE"
    ;;

  shadowrocket-module)
    write_shadowrocket_module
    printf '%s\n' "$SHADOWROCKET_MODULE"
    ;;

  shadowrocket-repair-module)
    write_shadowrocket_module "$SHADOWROCKET_REPAIR_TEMPLATE" "$SHADOWROCKET_REPAIR_MODULE"
    printf '%s\n' "$SHADOWROCKET_REPAIR_MODULE"
    ;;

  mihomo-profile|clash-profile)
    write_mihomo_profile
    printf '%s\n' "$MIHOMO_PROFILE"
    ;;

  doctor-public)
    write_shadowrocket_module "$SHADOWROCKET_REPAIR_TEMPLATE" "$SHADOWROCKET_REPAIR_MODULE"
    SHADOWROCKET_MODULE="$SHADOWROCKET_REPAIR_MODULE"
    doctor_public_network
    ;;

  install-fallback)
    run_with_relay_lock install_fallback_relay
    ;;

  uninstall-fallback)
    run_with_relay_lock uninstall_fallback_relay
    ;;

  __test-primary-proxy)
    printf '%s|%s\n' "$PRIMARY_PROXY_PORT" "$PRIMARY_PROXY_SOURCE"
    ;;

  __test-campus-probe)
    probe_data_plane || die "campus data path probe failed"
    printf '%s\n' "$PROBE_SUMMARY"
    ;;

  __test-render-fallback-plist)
    test_output="${2:-}"
    test_interface="${3:-en0}"
    [ -n "$test_output" ] || die "test output path is required"
    render_fallback_plist "$test_output" "$test_interface" \
      || die "could not render test relay LaunchAgent"
    ;;

  __test-fallback-owned)
    fallback_relay_listening || die "fallback listener is not owned by the LaunchAgent"
    printf 'owned\n'
    ;;

  __test-select-physical-interface)
    test_current="${2:-}"
    test_saved="${3:-}"
    test_current_active="${4:-0}"
    test_saved_active="${5:-0}"
    select_physical_interface \
      "$test_current" "$test_saved" "$test_current_active" "$test_saved_active" \
      || die "no physical interface selected"
    ;;

  install)
    require_account
    ensure_engine
    get_pw >/dev/null 2>&1 || die "set the password first"
    mkdir -p "$(dirname "$PLIST")"
    printf '%s\n' \
      '<?xml version="1.0" encoding="UTF-8"?>' \
      '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
      '<plist version="1.0"><dict>' \
      "<key>Label</key><string>$LABEL</string>" \
      '<key>ProgramArguments</key><array>' \
      "<string>$HERE/hkustgzconnect</string><string>run</string>" \
      '</array>' \
      '<key>RunAtLoad</key><true/>' \
      '<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>' \
      '<key>ThrottleInterval</key><integer>15</integer>' \
      "<key>StandardOutPath</key><string>$LOG</string>" \
      "<key>StandardErrorPath</key><string>$LOG</string>" \
      '</dict></plist>' > "$PLIST"
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
      || launchctl load "$PLIST" 2>/dev/null \
      || die "could not load the LaunchAgent"
    printf 'CLI autostart installed; the UI will attach to this shared engine\n'
    ;;

  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null \
      || launchctl unload "$PLIST" 2>/dev/null \
      || true
    [ -f "$PLIST" ] && mv "$PLIST" "$RUNDIR/com.hkustgz.connect.plist.uninstalled"
    printf 'CLI autostart removed\n'
    ;;

  logs)
    tail -n 40 -f "$LOG"
    ;;

  *)
    printf '%s\n' \
      'HKUST(GZ) Connect CLI' \
      '' \
      '  configure [username] [port]  create private local configuration' \
      '  set-password                 store the password in macOS Keychain' \
      '  set-policy FILE              install a private local network policy' \
      '  up                           start or attach to the shared engine' \
      '  down                         stop only the engine this CLI owns' \
      '  restart                      restart this CLI owner, then attach/start' \
      '  status                       verify listener ownership and campus access' \
      '  test                         run the approved campus data-path probe' \
      '  pac                          generate the campus-only PAC file' \
      '  shadowrocket-module          generate the minimal campus-only module' \
      '  shadowrocket-repair-module   generate opt-in realtime and DNS repair rules' \
      '  mihomo-profile               generate a Clash/Mihomo merge snippet' \
      '  doctor-public                compare public HTTPS prerequisite paths' \
      '  install-fallback             install the Shadowrocket coexistence relay' \
      '  uninstall-fallback           remove the Shadowrocket coexistence relay' \
      '  logs                         follow CLI-owned engine logs' \
      '  install                      install CLI launch-at-login ownership' \
      '  uninstall                    remove CLI launch-at-login ownership'
    ;;
esac
