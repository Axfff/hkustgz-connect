<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hkustgz.connect-fallback</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hkustgzconnect/bin/ec-fallback</string>
        <string>--listen</string>
        <string>127.0.0.1:1081</string>
        <string>--upstream</string>
        <string>127.0.0.1:1080</string>
        <string>--direct-interface</string>
        <string>en0</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.hkustgzconnect/fallback.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hkustgzconnect/fallback.err.log</string>
</dict>
</plist>
